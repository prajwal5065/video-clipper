GEMINI_API_KEY=your_key_here
# optional
GEMINI_MODEL=gemini-3.8-flash

# YouTube upload (see README: YouTube upload setup)
YT_CLIENT_SECRET_FILE=client_secret.json
# YouTube accounts you can upload to (comma separated). Keep 'main' first: it reuses token.json
YT_ACCOUNTS=main,second
# private | unlisted | public  (new Google Cloud projects are forced to private until audited)
YT_PRIVACY=private
# "Made for kids" declaration. true = audience is children (limits features); false = not made for kids
YT_MADE_FOR_KIDS=false
# 22 = People & Blogs, 24 = Entertainment, 27 = Education, 28 = Science & Tech
YT_CATEGORY_ID=22
